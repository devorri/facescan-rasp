# ============================================================
#  Lab Access Control — Raspberry Pi Environment Variables
# ============================================================
#  Copy this file to .env and fill in the values below.
#  The setup.sh script will load this file automatically.
# ============================================================

# --- Supabase (required) ---
SUPABASE_URL=https://nbcoxrxywbrcjldccinr.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key-here

# --- Laboratory identification (set ONE of the two below) ---
# Option A (recommended): use the lab name as stored in the `laboratories` table.
#   The script will resolve the UUID automatically on startup.
LABORATORY_NAME=CCS Laboratory

# Option B: hard-code the UUID directly (leave blank if using LABORATORY_NAME).
LABORATORY_ID=
