# ============================================================
#  Lab Access Control — Raspberry Pi Environment Variables
# ============================================================
#  Copy this file to .env and fill in the values below.
#  The setup.sh script will load this file automatically.
# ============================================================

# --- Supabase (required) ---
SUPABASE_URL=https://nbcoxrxywbrcjldccinr.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key-here

# --- Laboratory identification (set ONE of the two below) ---
# Option A (recommended): use the lab name as stored in the `laboratories` table.
#   The script will resolve the UUID automatically on startup.
LABORATORY_NAME=CCS Laboratory

# Option B: hard-code the UUID directly (leave blank if using LABORATORY_NAME).
LABORATORY_ID=

# --- Liveness / anti-spoofing (optional — defaults shown) ---
# 1 = person must do a random head-turn challenge before the door opens
REQUIRE_LIVENESS=1
# Random LEFT/RIGHT turns required at the door
RECOGNITION_CHALLENGES=1
# Random LEFT/RIGHT/UP/DOWN prompts required when enrolling a face
ENROLLMENT_CHALLENGES=3
ENROLLMENT_TIMEOUT_SECONDS=40
# Set to 1 if your camera gives a mirrored image (LEFT/RIGHT prompts feel reversed)
CAMERA_MIRRORED=0
# How far the head must turn (raise if too easy, lower if people struggle)
LIVENESS_YAW_THRESHOLD=0.085
LIVENESS_PITCH_THRESHOLD=0.075
# Passive photo/screen model (minifasnet_v2.onnx). Blocks only if avg live score < this
PASSIVE_ANTISPOOF=1
PASSIVE_LIVE_MIN=0.25

# --- Matching (optional) ---
# Lower = stricter. Never above 0.042.
FACE_MATCH_THRESHOLD=0.036
FACE_MATCH_MARGIN=0.012
# Enrollment refuses a face this close to ANOTHER profile (same person twice)
DUPLICATE_FACE_THRESHOLD=0.050
